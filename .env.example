# ============================================================
# Abuse-Ring Sentinel — Production & Database Configuration
# ============================================================

# Database Engine (mysql | sqlite)
DB_ENGINE=mysql

# MySQL Server Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=abuse_ring_sentinel
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Test Database (Used for automated test isolation)
MYSQL_TEST_DATABASE=abuse_ring_sentinel_test

# Connection Pool Settings
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=3600

# Application Profile
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Security & Limits
RATE_LIMIT_PER_MINUTE=120
MAX_PAYLOAD_SIZE_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30.0
