# ============================================================
# Abuse-Ring Sentinel — Production Environment Configuration
# ============================================================

# Environment: development | production | testing
APP_ENV=production

# Server Binding
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://sentinel.merchant.com,https://risk-console.merchant.com

# Artifact Paths
MODEL_PATH=models/model_f.joblib
AUDIT_LOG_PATH=reports/audit_log.jsonl

# Logging & Operational Metrics
LOG_LEVEL=INFO

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=120

# Payload Constraints
MAX_PAYLOAD_SIZE_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30.0
